# ─────────────────────────────────────────────────────────────────────────────
# eReseta+ — PRODUCTION environment template
# Copy to `.env` on the server and fill the blanks. NEVER commit the real .env.
# Lines marked ⚠️ are the security gates that MUST differ from local/dev.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="eReseta+"
APP_ENV=production                # ⚠️ not "local" — disables dev-only behavior
APP_KEY=                          # ⚠️ generate once on the server: php artisan key:generate
APP_DEBUG=false                   # ⚠️ MUST be false — true leaks stack traces + env in error responses
APP_URL=https://your-domain.com   # ⚠️ real HTTPS URL (drives signed URLs + public storage links)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Surface less in production logs (debug is noisy and can log sensitive context).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning                 # ⚠️ not "debug"

BCRYPT_ROUNDS=12

# ── Database (MySQL 8.4) ─────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ereseta
DB_USERNAME=ereseta_app           # ⚠️ a dedicated least-privilege user, NOT root
DB_PASSWORD=                      # ⚠️ a strong, unique password (never blank in prod)

# ── Sessions / cookies ───────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true              # ⚠️ encrypt session payloads at rest
SESSION_PATH=/
SESSION_DOMAIN=your-domain.com    # ⚠️ your real domain
SESSION_SECURE_COOKIE=true        # ⚠️ cookies only over HTTPS

# ── Sanctum (SPA + token auth) ───────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=your-domain.com   # ⚠️ the SPA origin(s), comma-separated
SANCTUM_TOKEN_EXPIRATION=1440              # 24h API token lifetime

# ── CORS — the deployed frontend origin (config/cors.php reads this) ─────────
FRONTEND_URL=https://your-domain.com       # ⚠️ exact scheme+host of the SPA; no wildcard

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public            # public-disk uploads (run: php artisan storage:link)
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail — a real SMTP provider so guest/booking/account emails actually send ─
MAIL_MAILER=smtp                  # ⚠️ not "log" in production
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="eReseta+"

# ── PayMongo (billing) ───────────────────────────────────────────────────────
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=              # ⚠️ keep secret — never expose to the frontend
PAYMONGO_WEBHOOK_SECRET=         # ⚠️ required so /webhooks/paymongo rejects forged callbacks

# ── Hyperledger Fabric (blockchain anchoring) ────────────────────────────────
BLOCKCHAIN_ENABLED=true           # live ledger writes for the thesis demo
FABRIC_GATEWAY_URL=http://127.0.0.1:3001
FABRIC_GATEWAY_TIMEOUT=10
FABRIC_GATEWAY_TOKEN=             # set the same strong secret in /var/www/ereseta/shared/fabric-gateway.env

VITE_APP_NAME="eReseta+"
