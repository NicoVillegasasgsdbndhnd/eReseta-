[Unit]
Description=eReseta+ database backup
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
Environment=APP_DIR=/var/www/ereseta/current
Environment=ENV_FILE=/var/www/ereseta/shared/.env
Environment=BACKUP_DIR=/var/www/ereseta/backups
Environment=RETENTION_DAYS=14
ExecStart=/var/www/ereseta/current/deploy/scripts/backup-db.sh

